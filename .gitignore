survivalcraft_linux/src/
survivalcraft_linux/build/

# Decompiled tree (output of decompile_survivalcraft.sh)
survivalcraft_decompiled/

# Source artifacts - never modified by the build
*.apk

# Scratch / logs
*.log
__pycache__/

# .NET build intermediates
bin/
obj/
