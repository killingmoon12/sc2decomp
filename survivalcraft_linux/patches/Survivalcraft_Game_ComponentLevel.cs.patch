+	/// <summary>Applies a host-authoritative level on a replica client.</summary>
+	public void SetNetLevel(float level)
+	{
+		PlayerData playerData = m_componentPlayer.PlayerData;
+		playerData.Level = level;
+		// A replica client skips Update(), which is what normally refreshes
+		// the label, so push the synced level straight to the HUD.
+		m_lastLevelTextValue = MathUtils.Floor(level);
+		if (m_componentPlayer.ComponentGui?.LevelLabelWidget != null)
+		{
+			m_componentPlayer.ComponentGui.LevelLabelWidget.Text = "Level " + MathUtils.Floor(level);
+		}
+	}
