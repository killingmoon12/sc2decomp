+	/// <summary>
+	/// Older builds wrote the multiplayer world snapshot through the host's own
+	/// save, which baked the joining remote avatar into the host world. Those
+	/// avatars reload as ordinary second players and turn the game into an
+	/// unwanted split-screen session. <see cref="PlayerData.SpawnPosition"/> is
+	/// assigned by the local spawn state machine before the entity is created,
+	/// so such a record has a spawned entity but still the zero spawn position.
+	/// A brand-new local player that has not spawned yet has no entity at all,
+	/// which is what distinguishes the two cases. Remove them once, after the
+	/// world has fully loaded.
+	/// </summary>
+	private void RemoveOrphanedPlayers()
+	{
+		if (MultiplayerManager.IsActive || MultiplayerManager.IsJoiningProject)
+		{
+			return;
+		}
+		List<PlayerData> list = null;
+		foreach (PlayerData playerData in m_playersData)
+		{
+			if (!playerData.IsRemote && playerData.ComponentPlayer != null && playerData.SpawnPosition == Vector3.Zero)
+			{
+				if (list == null)
+				{
+					list = new List<PlayerData>();
+				}
+				list.Add(playerData);
+			}
+		}
+		if (list == null)
+		{
+			return;
+		}
+		foreach (PlayerData item in list)
+		{
+			int playerIndex = item.PlayerIndex;
+			try
+			{
+				RemovePlayerData(item);
+				Log.Warning("[Multiplayer] Removed orphaned player {0} saved by an older snapshot bug.", playerIndex);
+			}
+			catch (Exception ex)
+			{
+				Log.Warning("[Multiplayer] Could not remove orphaned player {0}: {1}", playerIndex, ex.Message);
+			}
+		}
+	}
