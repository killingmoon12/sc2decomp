+	/// <summary>
+	/// Serializes the live project to a Project.xml element without touching
+	/// the world directory. Used to build a world snapshot for a joining
+	/// client: writing the snapshot through SaveProject would also write the
+	/// joining remote player into the host's own save, so a later crash or
+	/// alt-F4 would reload the world with that avatar as a local splitscreen
+	/// player.
+	/// </summary>
+	public static XElement CreateProjectXml()
+	{
+		if (m_project == null)
+		{
+			return null;
+		}
+		ProjectData projectData = m_project.Save();
+		XElement xElement = new XElement("Project");
+		projectData.Save(xElement);
+		XmlUtils.SetAttributeValue(xElement, "Version", VersionsManager.SerializationVersion);
+		return xElement;
+	}
