+	private void ToggleHosting()
+	{
+		if (MultiplayerSession.Mode == MultiplayerSessionMode.Host)
+		{
+			MultiplayerSession.Stop();
+			DialogsManager.HideDialog(this);
+			m_componentPlayer.ComponentGui.DisplaySmallMessage("Stopped hosting", Color.White, blinking: false, playNotificationSound: true);
+			return;
+		}
+		MultiplayerSession.StartHost(MultiplayerSession.DefaultPort);
+		if (MultiplayerSession.Mode == MultiplayerSessionMode.Host)
+		{
+			DialogsManager.HideDialog(this);
